# Copy to .env (not committed). Astro/Vite reads it at build time; PUBLIC_* values end up in the browser code.

# Test aids: key "L" solves the current puzzle, key "P" unlocks everything (levels, duel win, all cube styles).
# Only for development – leave it false (or unset) for the published site.
# GitHub Actions: repository variable PUBLIC_DEBUG (Settings → Secrets and variables → Actions → Variables).
PUBLIC_DEBUG=false
