---
import Base from '../../../layouts/Base.astro';
import GuessGame from '../../../components/GuessGame.astro';
import { useTranslations, otherLocalePaths } from '../../../i18n/index.js';

export const getStaticPaths = otherLocalePaths;
const { lang } = Astro.params;
---

<Base locale={lang} page="guess/" title={useTranslations(lang)('modes.guess.title')}>
  <GuessGame locale={lang} />
</Base>
