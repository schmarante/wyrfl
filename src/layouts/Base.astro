---
import '../styles/global.css';
import { useTranslations, localePath, LANGUAGES, DEFAULT_LOCALE } from '../i18n/index.js';
import { FLAGS, ICONS, SKIN_PREVIEWS } from '../scripts/ui/icons.js';
import { SKINS } from '../scripts/game/skin-pref.js';
import Icon from '../components/Icon.astro';

interface Props {
  locale: string;
  page: '' | 'about/' | 'guess/' | 'build/' | 'duel/';
  title?: string;
}
const { locale, page, title } = Astro.props;
const t = useTranslations(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const iconButton = 'press grid h-10 w-10 place-items-center rounded-full text-muted hover:bg-line hover:text-text';
---

<!doctype html>
<!-- translate="no": our own texts are already in the reader's language – no browser translation offer -->
<html lang={locale} translate="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#12151c" />
    <meta name="referrer" content="no-referrer" />
    <meta name="google" content="notranslate" />
    <!-- installable app (PWA): manifest + icons; the service worker is registered at the end of the page -->
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}/pwa/apple-touch-icon.png`} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Wyrfl" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>{title ? `${title} · Wyrfl` : t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    {LANGUAGES.map(({ code }) => <link rel="alternate" hreflang={code} href={localePath(code, page)} />)}
    <!-- language, like ../rindr and ../mixr: ?lang=… > stored choice ('wyrfl:lang', set by the language menu) >
         browser languages in order > German. The language lives in the URL here (/en/, /fr/ …): ?lang= works on every
         page, the rest only on German (unprefixed) pages – a shared /en/… link always opens in English.
         Runs before the first paint. -->
    <script is:inline define:vars={{ codes: LANGUAGES.map(l => l.code), fallback: DEFAULT_LOCALE, current: locale, page, base }}>
      try {
        const match = value => {
          const code = String(value || '').trim().toLowerCase().split(/[-_;]/)[0];
          return codes.includes(code) ? code : undefined;
        };
        const params = new URLSearchParams(location.search);
        const query = match(params.get('lang'));
        let stored = null;
        try { stored = localStorage.getItem('wyrfl:lang'); } catch {}
        const wanted = query
          ?? (current === fallback ? match(stored) ?? (navigator.languages || [navigator.language]).map(match).find(Boolean) : undefined)
          ?? current;
        if (wanted !== current) {
          params.delete('lang');
          const search = params.toString() ? `?${params}` : '';
          location.replace(`${base}${wanted === fallback ? '' : `/${wanted}`}/${page}${search}${location.hash}`);
        }
      } catch {}
    </script>
    <!-- theme before the first paint (no flash); dark is the default -->
    <script is:inline>
      try {
        if (localStorage.getItem('wyrfl:theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
          document.querySelector('meta[name="theme-color"]').content = '#eef1f6';
        }
      } catch {}
    </script>
  </head>
  <body class="min-h-dvh bg-bg text-text antialiased">
    <div class="mx-auto flex min-h-dvh max-w-3xl flex-col land:max-w-7xl px-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] sm:px-4">
      <header class="flex items-center justify-between py-2">
        <a href={localePath(locale)} class="flex items-center gap-2 text-xl font-extrabold tracking-tight">
          <img src={`${base}/favicon.svg`} alt="" width="28" height="28" />
          Wyrfl
        </a>
        <nav class="flex items-center gap-1">
          <!-- language menu: current flag, opens a list of all languages (each named in itself) -->
          <details data-lang-menu class="relative">
            <summary class="press flex h-10 cursor-pointer list-none items-center gap-1 rounded-full px-2 text-muted hover:text-text [&::-webkit-details-marker]:hidden"
                     aria-label={t('nav.language')} title={t('nav.language')}>
              <Fragment set:html={FLAGS[locale]} />
              <Fragment set:html={ICONS.chevron} />
            </summary>
            <ul class="absolute right-0 z-40 mt-1 min-w-44 overflow-hidden rounded-2xl border-2 border-line bg-surface py-1 shadow-lg">
              {LANGUAGES.map(({ code, name }) => (
                <li>
                  <a href={localePath(code, page)} hreflang={code} lang={code} data-lang={code} aria-current={code === locale ? 'true' : undefined}
                     class:list={['flex items-center gap-3 px-3 py-2.5 text-sm hover:bg-line', code === locale && 'font-bold']}>
                    <Fragment set:html={FLAGS[code]} />
                    <span class="flex-1">{name}</span>
                    {code === locale && <span class="text-front" aria-hidden="true">✓</span>}
                  </a>
                </li>
              ))}
            </ul>
          </details>
          <!-- cube style menu: preview of the current style; the choice is stored on this device -->
          <details data-skin-menu class="relative">
            <summary class="press flex h-10 cursor-pointer list-none items-center gap-1 rounded-full px-2 text-muted hover:text-text [&::-webkit-details-marker]:hidden"
                     aria-label={t('nav.skin')} title={t('nav.skin')}>
              <span data-skin-current class="flex"><Fragment set:html={SKIN_PREVIEWS.classic} /></span>
              <Fragment set:html={ICONS.chevron} />
            </summary>
            <ul class="absolute right-0 z-40 mt-1 w-64 overflow-hidden rounded-2xl border-2 border-line bg-surface py-1 shadow-lg" role="menu">
              {SKINS.map(name => (
                <li>
                  <button type="button" role="menuitemradio" aria-checked="false" data-skin={name}
                          class="flex w-full items-center gap-3 px-3 py-2.5 text-left text-sm hover:bg-line aria-checked:font-bold disabled:cursor-not-allowed disabled:hover:bg-transparent">
                    <span data-skin-preview class="flex"><Fragment set:html={SKIN_PREVIEWS[name]} /></span>
                    <span class="flex flex-1 flex-col">
                      <span>{t(`skins.${name}`)}</span>
                      {name !== 'classic' && <span data-skin-hint hidden class="text-xs font-normal text-muted">{t(`skins.unlock.${name}`)}</span>}
                    </span>
                    <span data-skin-lock hidden class="text-muted"><Fragment set:html={ICONS.lock} /></span>
                    <span data-skin-check hidden class="text-front" aria-hidden="true">✓</span>
                  </button>
                </li>
              ))}
            </ul>
          </details>
          <button type="button" data-theme-toggle class={iconButton} aria-label={t('nav.theme')} title={t('nav.theme')}>
            <span class="theme-dark-icon flex"><Icon name="sun" /></span>
            <span class="theme-light-icon flex" hidden><Icon name="moon" /></span>
          </button>
          <a href={localePath(locale, 'about/')} class={iconButton} aria-label={t('nav.about')} title={t('nav.about')}
             aria-current={page === 'about/' ? 'page' : undefined}>
            <Icon name="info" />
          </a>
        </nav>
      </header>

      <main class="flex-1">
        <slot />
      </main>
    </div>

    <script>
      import { currentSkin, setSkin, skinUnlocked } from '../scripts/game/skin-pref.js';
      import { registerUnlockAllShortcut } from '../scripts/ui/debug-solve.js';

      registerUnlockAllShortcut();   // test aid: key "P" when built with PUBLIC_DEBUG=true

      // a language picked in the menu is stored and wins over the browser language from now on (script in <head>)
      document.querySelectorAll<HTMLAnchorElement>('[data-lang]').forEach(link =>
        link.addEventListener('click', () => {
          try {
            localStorage.setItem('wyrfl:lang', link.dataset.lang!);
          } catch {
            /* not stored */
          }
        }),
      );

      // installable app: service worker (production builds only – the dev server must not be cached)
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        navigator.serviceWorker.register(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sw.js`).catch(() => {
          /* no offline mode – the game still works */
        });
      }

      // light/dark toggle – stored on this device only; the 3D scenes listen to 'wyrfl-theme'
      const root = document.documentElement;
      const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
      const sync = () => {
        const light = root.dataset.theme === 'light';
        button.querySelector<HTMLElement>('.theme-dark-icon')!.hidden = light;
        button.querySelector<HTMLElement>('.theme-light-icon')!.hidden = !light;
        document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!.content = light ? '#eef1f6' : '#12151c';
      };
      button.addEventListener('click', () => {
        const light = root.dataset.theme !== 'light';
        if (light) root.dataset.theme = 'light';
        else delete root.dataset.theme;
        try {
          localStorage.setItem('wyrfl:theme', light ? 'light' : 'dark');
        } catch {
          /* not stored */
        }
        sync();
        window.dispatchEvent(new CustomEvent('wyrfl-theme'));
      });
      sync();

      // header menus (language, cube style): close on a click outside or Escape
      const menus = [...document.querySelectorAll<HTMLDetailsElement>('[data-lang-menu], [data-skin-menu]')];
      document.addEventListener('click', e => {
        for (const menu of menus) if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
      });
      document.addEventListener('keydown', e => {
        if (e.key !== 'Escape') return;
        for (const menu of menus) {
          if (!menu.open) continue;
          menu.open = false;
          menu.querySelector('summary')!.focus();
        }
      });

      // cube style menu
      const skinMenu = document.querySelector<HTMLDetailsElement>('[data-skin-menu]')!;
      // locked styles: dimmed, lock icon + how to unlock them; re-checked whenever the menu opens or the style changes
      const syncSkin = () => {
        const name = currentSkin();
        for (const item of skinMenu.querySelectorAll<HTMLButtonElement>('[data-skin]')) {
          const unlocked = skinUnlocked(item.dataset.skin!);
          const active = item.dataset.skin === name;
          item.disabled = !unlocked;
          item.setAttribute('aria-checked', String(active));
          item.querySelector<HTMLElement>('[data-skin-check]')!.hidden = !active;
          item.querySelector<HTMLElement>('[data-skin-lock]')!.hidden = unlocked;
          const hint = item.querySelector<HTMLElement>('[data-skin-hint]');
          if (hint) hint.hidden = unlocked;
          item.querySelector('[data-skin-preview]')!.classList.toggle('opacity-40', !unlocked);
          // gifts are a surprise on St. Nicholas' Day and at Christmas – on other days they are not in the menu at all
          item.closest('li')!.hidden = item.dataset.skin === 'gifts' && !unlocked;
          if (active) skinMenu.querySelector('[data-skin-current]')!.innerHTML = item.querySelector('svg')!.outerHTML;
        }
      };
      skinMenu.querySelectorAll<HTMLButtonElement>('[data-skin]').forEach(item =>
        item.addEventListener('click', () => {
          setSkin(item.dataset.skin!);
          skinMenu.open = false;
        }),
      );
      skinMenu.addEventListener('toggle', () => skinMenu.open && syncSkin());
      window.addEventListener('wyrfl-skin', syncSkin);
      syncSkin();
    </script>
  </body>
</html>
