---
// Start page: hero (turntable with buildings that assemble themselves, changing sizes) and – beside it from tablet
// landscape / desktop on, below it on phones – the claim with the game modes underneath.
import { useTranslations, localePath } from '../i18n/index.js';
import Icon from './Icon.astro';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const modes = [
  { id: 'guess', icon: 'eye', tint: 'bg-cube/15 text-cube' },
  { id: 'shadow', icon: 'sun', tint: 'bg-front/20 text-front' },
  { id: 'build', icon: 'build', tint: 'bg-cube/15 text-cube' },
  { id: 'duel', icon: 'duel', tint: 'bg-front/20 text-front' },
] as const;
const side = 'lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] land:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]';
---

<div class={`mt-1 grid gap-3 lg:gap-x-10 land:gap-x-8 xl:gap-x-14 ${side}`}>
  <section id="hero" class="relative overflow-hidden rounded-3xl border-2 border-line bg-surface aspect-[4/3] sm:aspect-[2/1] lg:aspect-auto lg:min-h-[30rem] land:aspect-auto land:h-[calc(100dvh-5.5rem)]">
    <canvas data-hero class="absolute inset-0 h-full w-full cursor-grab active:cursor-grabbing" aria-hidden="true"></canvas>
  </section>

  {/* claim + game modes: right of the hero (tablet landscape / desktop), below it on phones */}
  <div class="flex flex-col gap-3 lg:justify-center land:justify-center">
  <h1 class="px-1 text-2xl font-extrabold leading-tight sm:text-3xl lg:mb-2 lg:text-4xl land:mb-2">
    {t('home.claim')}
  </h1>
  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1 land:grid-cols-1">
    {modes.map(mode => (
      <li>
        <a href={localePath(locale, mode.id)}
           class="press flex h-full items-center gap-4 rounded-3xl border-2 border-line bg-surface p-4 hover:border-cube sm:flex-col sm:items-start lg:flex-row lg:items-center land:flex-row land:items-center lg:p-5">
          <span class:list={['grid h-14 w-14 shrink-0 place-items-center rounded-2xl', mode.tint]}><Icon name={mode.icon} /></span>
          <span class="flex flex-col gap-1">
            <span class="text-lg font-bold">{t(`modes.${mode.id}.title`)}</span>
            <span class="text-sm text-muted">{t(`modes.${mode.id}.text`)}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
  </div>
</div>

<script>
  // Turntable: a building assembles itself, turns for a while, fades out – next one, sizes 3×3 … 6×6.
  // Runs only while the hero is on screen; with "reduce motion" a single building just stands there.
  import { generateStructure } from '../scripts/game/structure.js';

  const LEVELS = ['easy', 'medium', 'hard', 'hardcore'];
  const SPEED = 0.35;        // rad/s
  const SHOW_FOR = 6500;     // ms per building
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero]')!;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const seed = () => Array.from(crypto.getRandomValues(new Uint32Array(2)), n => n.toString(36)).join('');

  import('../scripts/game/scene.js')
    .then(({ createCubeScene }) => {
      const scene = createCubeScene(canvas, { frameFor: { size: 6, maxHeight: 5 } });
      let index = Math.floor(Math.random() * LEVELS.length);
      let timer = 0;
      let visible = true;

      const show = (first: boolean) =>
        scene.setStructure(generateStructure(seed(), LEVELS[index++ % LEVELS.length]), { animate: !reduce, keepView: !first });
      const next = async () => {
        if (!visible) return;
        await scene.clear();
        if (!visible) return;
        show(false);
        timer = window.setTimeout(next, SHOW_FOR);
      };

      show(true);
      if (reduce) return;
      scene.setAutoRotate(SPEED);
      timer = window.setTimeout(next, SHOW_FOR);

      // pause off screen (battery): no frame loop, no new buildings
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        clearTimeout(timer);
        scene.setAutoRotate(visible ? SPEED : 0);
        if (visible) timer = window.setTimeout(next, SHOW_FOR / 2);
      }).observe(canvas);
    })
    .catch(() => {
      /* no WebGL: the hero just shows the claim */
    });
</script>
