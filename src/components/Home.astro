---
// Start page: straight to the game modes.
import { useTranslations, localePath } from '../i18n/index.js';
import Icon from './Icon.astro';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const modes = [
  { id: 'guess', path: 'guess/', icon: 'eye', tint: 'bg-cube/15 text-cube' },
  { id: 'build', path: 'build/', icon: 'build', tint: 'bg-front/20 text-front' },
  { id: 'duel', path: 'duel/', icon: 'duel', tint: 'bg-cube/15 text-cube' },
] as const;
---

<h1 class="sr-only">Wyrfl – {t('modes.title')}</h1>
<ul class="mt-2 grid gap-3 sm:grid-cols-3">
  {modes.map(mode => (
    <li>
      <a href={localePath(locale, mode.path)}
         class="press flex h-full items-center gap-4 rounded-3xl border border-line bg-surface p-4 hover:border-cube sm:flex-col sm:items-start">
        <span class:list={['grid h-14 w-14 shrink-0 place-items-center rounded-2xl', mode.tint]}><Icon name={mode.icon} /></span>
        <span class="flex flex-col gap-1">
          <span class="text-lg font-bold">{t(`modes.${mode.id}.title`)}</span>
          <span class="text-sm text-muted">{t(`modes.${mode.id}.text`)}</span>
        </span>
      </a>
    </li>
  ))}
</ul>
