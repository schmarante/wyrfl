---
// Start page: today's Wyrfl as a 3D preview with its three views, plus the upcoming game modes.
import { useTranslations } from '../i18n/index.js';
import { VIEWS } from '../scripts/game/structure.js';

interface Props {
  locale: 'de' | 'en';
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const modes = ['guess', 'build', 'timeAttack'];
---

<section class="flex flex-col gap-6">
  <p class="text-lg text-muted">{t('home.tagline')}</p>

  <div id="daily" class="rounded-3xl border border-line bg-surface p-4 sm:p-6"
       data-title={t('home.dailyTitle')} data-cubes={t('home.cubes')}>
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h1 class="text-xl font-bold" data-daily-title>&nbsp;</h1>
      <span class="text-sm text-muted" data-daily-cubes></span>
    </div>

    <div class="relative mt-4 aspect-square w-full sm:aspect-[4/3]">
      <canvas data-daily-canvas class="absolute inset-0 h-full w-full cursor-grab active:cursor-grabbing"
              aria-label={t('home.dragHint')} role="img"></canvas>
      <p data-daily-nowebgl hidden class="absolute inset-0 grid place-items-center text-center text-muted">{t('home.noWebgl')}</p>
    </div>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-muted">{t('home.dragHint')}</p>
      <button type="button" data-daily-reset
              class="press min-h-11 rounded-full bg-line px-5 text-sm font-semibold hover:bg-cube/40">
        {t('home.resetView')}
      </button>
    </div>

    <h2 class="mt-6 font-semibold">{t('home.viewsTitle')}</h2>
    <ul class="mt-3 grid grid-cols-3 gap-3">
      {VIEWS.map(view => (
        <li class="flex flex-col items-center gap-2 rounded-2xl bg-bg/60 p-3">
          <div data-view={view} class="grid w-full max-w-28 gap-0.5" aria-label={t(`views.${view}`)} role="img"></div>
          <span class:list={['text-sm font-semibold', view === 'front' ? 'text-front' : 'text-muted']}>{t(`views.${view}`)}</span>
        </li>
      ))}
    </ul>
  </div>

  <section>
    <h2 class="mb-3 text-lg font-bold">{t('home.modesTitle')}</h2>
    <ul class="grid gap-3 sm:grid-cols-3">
      {modes.map(mode => (
        <li class="flex flex-col gap-2 rounded-2xl border border-line bg-surface p-4 opacity-80">
          <span class="font-bold">{t(`modes.${mode}.title`)}</span>
          <span class="text-sm text-muted">{t(`modes.${mode}.text`)}</span>
          <span class="mt-auto self-start rounded-full bg-line px-3 py-1 text-xs text-muted">{t('home.comingSoon')}</span>
        </li>
      ))}
    </ul>
  </section>
</section>

<script>
  import { dailyDate, puzzleNumber } from '../scripts/game/rng.js';
  import { generateStructure, computeView, cubeCount, VIEWS } from '../scripts/game/structure.js';

  const root = document.getElementById('daily')!;
  const date = dailyDate();
  const structure = generateStructure(`daily:${date}`, 'easy');

  root.querySelector('[data-daily-title]')!.textContent = root.dataset.title!.replace('{number}', String(puzzleNumber(date)));
  root.querySelector('[data-daily-cubes]')!.textContent = root.dataset.cubes!.replace('{count}', String(cubeCount(structure)));

  // 2D views as small CSS grids
  for (const view of VIEWS) {
    const grid = computeView(structure, view);
    const el = root.querySelector<HTMLElement>(`[data-view="${view}"]`)!;
    el.style.gridTemplateColumns = `repeat(${grid[0].length}, 1fr)`;
    el.replaceChildren(...grid.flat().map(filled => {
      const cell = document.createElement('span');
      cell.className = `aspect-square rounded-[3px] ${filled ? (view === 'front' ? 'bg-front' : 'bg-cube') : 'bg-line/50'}`;
      return cell;
    }));
  }

  // 3D view – three.js is loaded only here
  const canvas = root.querySelector<HTMLCanvasElement>('[data-daily-canvas]')!;
  import('../scripts/game/scene.js')
    .then(({ createCubeScene }) => {
      const cubeScene = createCubeScene(canvas);
      cubeScene.setStructure(structure);
      root.querySelector('[data-daily-reset]')!.addEventListener('click', () => cubeScene.resetView());
    })
    .catch(() => {
      canvas.hidden = true;
      root.querySelector<HTMLElement>('[data-daily-nowebgl]')!.hidden = false;
    });
</script>
