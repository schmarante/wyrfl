---
import { useTranslations } from '../i18n/index.js';
import { RUNTIME, ASSETS, BUILD, ABOUT } from '../data/credits.js';
import { ICONS } from '../scripts/ui/icons.js';
import pkg from '../../package.json';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const groups = [
  { title: t('about.runtime'), items: RUNTIME },
  { title: t('about.assets'), items: ASSETS },
  { title: t('about.build'), items: BUILD },
];
---

<article class="mx-auto flex max-w-3xl flex-col gap-4 leading-relaxed">
  <h1 class="text-2xl font-bold">{t('about.title')}</h1>
  <p>{t('about.intro')}</p>
  <p>{t('about.privacy')}</p>
  <p>{t('about.license')}</p>
  <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
    <dt class="text-muted">{t('about.author')}</dt><dd>{ABOUT.author}</dd>
    <dt class="text-muted">{t('about.email')}</dt><dd><a href={`mailto:${ABOUT.email}`} class="text-link underline-offset-2 hover:underline">{ABOUT.email}</a></dd>
    <dt class="text-muted">{t('about.version')}</dt><dd>{pkg.version}</dd>
  </dl>
  <p class="font-semibold"><Fragment set:html={t('about.madeWith').replace('{heart}', ICONS.heart)} /></p>
  <p class="text-muted">{t('about.openSource')}</p>

  {groups.map(group => (
    <section>
      <h2 class="mb-2 mt-2 font-semibold">{group.title}</h2>
      <div class="overflow-x-auto rounded-2xl border-2 border-line">
        <table class="w-full text-left text-sm">
          <thead class="bg-surface text-muted">
            <tr><th class="p-3">{t('about.project')}</th><th class="p-3">{t('about.usedFor')}</th><th class="p-3">{t('about.licenseCol')}</th></tr>
          </thead>
          <tbody>
            {group.items.map(item => (
              <tr class="border-t border-line">
                <td class="p-3"><a href={item.url} class="text-link underline-offset-2 hover:underline">{item.name}</a></td>
                <td class="p-3">{t(`about.libs.${item.id}`)}</td>
                <td class="p-3 whitespace-nowrap">{item.license}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}
</article>
