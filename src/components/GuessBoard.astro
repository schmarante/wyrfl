---
// Playing field of the View Guesser (question, 3D building, six options, feedback) – used by GuessGame and DuelGame.
// Bar above the 3D view: [data-level-picker] (stars) left, back-to-tilted + hint right – a bar of its own, not laid
// over the picture, so tall columns are never covered. Logic: src/scripts/ui/guess-board.js
// Phone: question → 3D → options → feedback (+ default slot, e.g. "next puzzle").
// Tablet landscape and up (`land:`): 3D on the left (full height); on the right the question, the options in two
// columns, below them feedback and the default slot – sized from the screen height so everything fits on a 16:9 screen.
import { useTranslations } from '../i18n/index.js';
import Icon from './Icon.astro';

interface Props {
  locale: string;
}
const t = useTranslations(Astro.props.locale);
const overlayButton = 'press pointer-events-auto grid h-10 w-10 place-items-center rounded-full bg-surface/85 text-text shadow-sm backdrop-blur hover:bg-line disabled:cursor-not-allowed disabled:opacity-35';
// --opt = one option's width in landscape: three rows of options + feedback + button have to fit under the header
// landscape grid: 3D view on the left over all rows; right: question, options, feedback (+ slot)
const layout = [
  'land:grid land:grid-cols-[minmax(0,1fr)_auto] land:grid-rows-[auto_auto_1fr] land:gap-x-5',
  'land:[--opt:clamp(4.5rem,calc((100dvh-24rem)/3),11rem)]',
].join(' ');
const rightColumn = 'land:col-start-2 land:w-[calc(var(--opt)*2+0.75rem)]';
---

<div data-guess-board class={layout}>
  <!-- the question: above the 3D view on phones, at the top of the right column (above the answers) in landscape -->
  <h1 data-question class={`text-lg font-bold leading-snug sm:text-xl land:row-start-1 land:mb-3 land:text-lg ${rightColumn}`}>&nbsp;</h1>

  <div class="min-w-0 land:col-start-1 land:row-span-3 land:row-start-1">
    <div class="mt-2 overflow-hidden rounded-2xl bg-bg/50 land:mt-0">
      <!-- own bar above the 3D picture: tall columns get their room below it, nothing is covered -->
      <div class="flex min-h-12 items-center justify-between gap-2 px-2 pt-2">
        <div data-level-picker></div>
        <div class="flex gap-1.5">
          <button type="button" data-iso hidden class={overlayButton} aria-label={t('guess.backToIso')} data-i18n-aria="guess.backToIso" title={t('guess.backToIso')} data-i18n-title="guess.backToIso">
            <Icon name="iso" />
          </button>
          <button type="button" data-hint disabled class={overlayButton} aria-label={t('guess.hint')} data-i18n-aria="guess.hint" title={t('guess.hint')} data-i18n-title="guess.hint">
            <Icon name="bulb" />
          </button>
        </div>
      </div>
      <div class="relative aspect-[5/4] w-full sm:aspect-[16/10] land:aspect-auto land:h-[max(15rem,calc(100dvh-11rem))]">
        <canvas data-canvas class="absolute inset-0 h-full w-full cursor-grab active:cursor-grabbing" role="img"
                aria-label={t('home.dragHint')} data-i18n-aria="home.dragHint"></canvas>
        <p data-loading class="absolute inset-0 grid place-items-center text-muted" data-i18n="game.loading">{t('game.loading')}</p>
      </div>
    </div>
  </div>

  <ul data-options class={`mt-3 grid grid-cols-3 gap-2 sm:gap-3 land:mt-0 land:row-start-2 land:grid-cols-2 land:content-start ${rightColumn}`}></ul>

  <div class={`land:row-start-3 ${rightColumn}`}>
    <p data-feedback class="mt-3 min-h-6 px-1 text-base font-semibold land:text-sm" aria-live="polite"></p>
    <slot />
  </div>
</div>
