---
// Playing field of the View Guesser (question, 3D building, six options, feedback) – used by GuessGame and DuelGame.
// Top left of the 3D view: [data-level-picker] (stars), top right: back-to-tilted + hint. Logic: src/scripts/ui/guess-board.js
// Phone: question → 3D → options → feedback. Tablet landscape and up (`land:`): 3D left (full height), options in a
// column on the right, two columns when there is room (`land-wide:`). The default slot goes under the feedback.
import { useTranslations } from '../i18n/index.js';
import Icon from './Icon.astro';

interface Props {
  locale: string;
}
const t = useTranslations(Astro.props.locale);
const overlayButton = 'press pointer-events-auto grid h-10 w-10 place-items-center rounded-full bg-surface/85 text-text shadow-sm backdrop-blur hover:bg-line disabled:cursor-not-allowed disabled:opacity-35';
// option size in landscape: six (one column) or three (two columns) options fill the screen height
const optionColumn = [
  'land:mt-0 land:col-start-2 land:row-span-2 land:row-start-1 land:content-start land:grid-cols-1',
  'land:w-[var(--opt)] land:[--opt:clamp(5.5rem,calc((100dvh-8rem)/6-0.5rem),10rem)]',
  'land-wide:grid-cols-2 land-wide:w-[calc(var(--opt)*2+0.75rem)] land-wide:[--opt:clamp(8rem,calc((100dvh-8rem)/3-0.75rem),11.5rem)]',
].join(' ');
---

<div data-guess-board class="land:grid land:grid-cols-[minmax(0,1fr)_auto] land:grid-rows-[auto_1fr] land:gap-x-4">
  <div class="min-w-0 land:col-start-1 land:row-start-1">
    <h1 data-question class="text-lg font-bold leading-snug sm:text-xl">&nbsp;</h1>

    <div class="relative mt-2 aspect-[5/4] w-full overflow-hidden rounded-2xl bg-bg/50 sm:aspect-[16/10] land:aspect-auto land:h-[max(20rem,calc(100dvh-12rem))]">
      <canvas data-canvas class="absolute inset-0 h-full w-full cursor-grab active:cursor-grabbing" role="img"
              aria-label={t('home.dragHint')}></canvas>
      <p data-loading class="absolute inset-0 grid place-items-center text-muted">{t('game.loading')}</p>
      <div class="pointer-events-none absolute inset-x-2 top-2 flex items-start justify-between gap-2">
        <div data-level-picker></div>
        <div class="flex gap-1.5">
          <button type="button" data-iso hidden class={overlayButton} aria-label={t('guess.backToIso')} title={t('guess.backToIso')}>
            <Icon name="iso" />
          </button>
          <button type="button" data-hint disabled class={overlayButton} aria-label={t('guess.hint')} title={t('guess.hint')}>
            <Icon name="bulb" />
          </button>
        </div>
      </div>
    </div>
  </div>

  <ul data-options class={`mt-3 grid grid-cols-3 gap-2 sm:gap-3 ${optionColumn}`}></ul>

  <div class="land:col-start-1 land:row-start-2">
    <p data-feedback class="mt-3 min-h-6 px-1 text-base font-semibold" aria-live="polite"></p>
    <slot />
  </div>
</div>
