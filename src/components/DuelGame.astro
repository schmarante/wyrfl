---
// Duel: two devices in the same WLAN, paired by QR code (WebRTC without server), same View Guesser puzzles.
// Logic: src/scripts/duel/duel-app.js
import { useTranslations } from '../i18n/index.js';
import { LEVELS } from '../scripts/game/progress.js';
import { AVATARS, avatarUrl } from '../scripts/duel/avatars.js';
import GuessBoard from './GuessBoard.astro';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const primary = 'press inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-cube px-6 text-lg font-bold text-on-cube hover:brightness-110 disabled:opacity-40';
const secondary = 'press inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-line px-5 text-sm font-semibold hover:bg-cube/40 disabled:opacity-40';
const card = 'mx-auto w-full max-w-3xl rounded-3xl border-2 border-line bg-surface p-4 sm:p-6';
const qrBox = 'mx-auto aspect-square w-full max-w-72 overflow-hidden rounded-2xl bg-white p-2';
// test aid (PUBLIC_DEBUG=true): pair by copy & paste instead of scanning – not part of the published game, so not translated
const debug = import.meta.env.PUBLIC_DEBUG === 'true';
---

<section id="duel" class="flex flex-col gap-4">
  <p data-banner hidden class="mx-auto w-full max-w-3xl rounded-2xl border-2 border-front/60 bg-front/10 p-3 text-sm font-semibold" role="alert"></p>

  {/* start */}
  <div data-screen="start" class={card}>
    <h1 class="text-xl font-bold" data-i18n="modes.duel.title">{t('modes.duel.title')}</h1>
    <p class="mt-2" data-i18n="duel.intro">{t('duel.intro')}</p>
    <p class="mt-2 text-sm text-muted" data-i18n="duel.privacy">{t('duel.privacy')}</p>
    <p class="mt-4 text-sm font-semibold" id="duel-avatar-label" data-i18n="duel.pickAvatar">{t('duel.pickAvatar')}</p>
    <div data-avatars class="mt-2 grid grid-cols-8 gap-1.5 max-sm:grid-cols-6" role="radiogroup" aria-labelledby="duel-avatar-label">
      {AVATARS.map(id => (
        <button type="button" role="radio" aria-checked="false" data-avatar={id} aria-label={t(`avatars.${id}`)} data-i18n-aria={`avatars.${id}`} title={t(`avatars.${id}`)} data-i18n-title={`avatars.${id}`}
                class="press grid aspect-square place-items-center rounded-2xl border-2 border-transparent bg-bg/60 p-1.5 hover:border-line aria-checked:border-cube aria-checked:bg-cube/15">
          <img src={avatarUrl(id)} alt="" width="40" height="40" class="h-full w-full" draggable="false" />
        </button>
      ))}
    </div>
    <p data-unsupported hidden class="mt-4 text-sm font-semibold text-front" data-i18n="duel.unsupported">{t('duel.unsupported')}</p>
    <div class="mt-5 grid gap-3 sm:grid-cols-2">
      <button type="button" data-host class={primary} data-i18n="duel.host">{t('duel.host')}</button>
      <button type="button" data-join class={`${secondary} min-h-12 text-base`} data-i18n="duel.join">{t('duel.join')}</button>
    </div>
  </div>

  {/* host: show offer, scan answer */}
  <div data-screen="host" hidden class={card}>
    <h1 data-host-title class="text-xl font-bold">{t('duel.host')}</h1>
    <p class="mt-3" data-i18n="duel.step1">{t('duel.step1')}</p>
    <div data-offer-qr class={`${qrBox} mt-3 grid place-items-center text-muted`} data-i18n="duel.preparing">{t('duel.preparing')}</div>
    <p class="mt-5" data-i18n="duel.step2">{t('duel.step2')}</p>
    <button type="button" data-scan-answer disabled class={`${primary} mt-3 w-full`} data-i18n="duel.scanAnswer">{t('duel.scanAnswer')}</button>
    <p data-host-status class="mt-3 min-h-6 text-sm font-semibold" aria-live="polite"></p>
    {/* adding a 3rd / 4th player: back without pairing */}
    <button type="button" data-back-lobby hidden class={`${secondary} w-full`} data-i18n="duel.backToLobby">{t('duel.backToLobby')}</button>
    {debug && (
      <div class="mt-4 flex flex-col gap-2 rounded-xl border-2 border-dashed border-front/60 p-3 text-sm">
        <p class="font-semibold text-front">Debug: ohne Kamera koppeln</p>
        <button type="button" data-copy-link disabled class={secondary}>Link kopieren</button>
        <label for="duel-paste" class="mt-1">Antwort-Code des anderen Geräts einfügen</label>
        <textarea id="duel-paste" data-paste rows="3" class="w-full rounded-xl border-2 border-line bg-bg p-2 font-mono text-xs"></textarea>
        <button type="button" data-paste-connect class={secondary}>Verbinden</button>
      </div>
    )}
  </div>

  {/* guest: show answer */}
  <div data-screen="guest" hidden class={card}>
    <h1 class="text-xl font-bold" data-i18n="duel.answerTitle">{t('duel.answerTitle')}</h1>
    <p class="mt-3" data-i18n="duel.answerText">{t('duel.answerText')}</p>
    <div data-answer-qr class={`${qrBox} mt-3 grid place-items-center text-muted`} data-i18n="duel.connecting">{t('duel.connecting')}</div>
    <p data-guest-status class="mt-3 min-h-6 text-sm font-semibold" aria-live="polite" data-i18n="duel.waiting">{t('duel.waiting')}</p>
    {debug && (
      <div class="mt-4 flex flex-col gap-2 rounded-xl border-2 border-dashed border-front/60 p-3 text-sm">
        <p class="font-semibold text-front">Debug: ohne Kamera koppeln</p>
        <button type="button" data-copy-code disabled class={secondary}>Antwort-Code kopieren</button>
      </div>
    )}
  </div>

  {/* lobby */}
  <div data-screen="lobby" hidden class={card}>
    <div data-versus class="flex items-center justify-center gap-4 py-2"></div>
    <h1 data-connected class="text-center text-xl font-bold"></h1>
    <div data-host-only class="mt-4 flex flex-col gap-4">
      <div>
        <p class="mb-2 text-sm font-semibold" data-i18n="duel.level">{t('duel.level')}</p>
        <div data-duel-levels class="flex gap-2" role="group" aria-label={t('duel.level')} data-i18n-aria="duel.level">
          {LEVELS.map((level, i) => (
            <button type="button" data-level={level} aria-pressed={i === 0 ? 'true' : 'false'}
                    class="press min-h-11 flex-1 rounded-full bg-line px-2 text-sm font-semibold aria-pressed:bg-cube aria-pressed:text-on-cube" data-i18n={`levels.${level}`}>
              {t(`levels.${level}`)}
            </button>
          ))}
        </div>
      </div>
      <div>
        <p class="mb-2 text-sm font-semibold" data-i18n="duel.rounds">{t('duel.rounds')}</p>
        <div data-duel-rounds class="flex gap-2" role="group" aria-label={t('duel.rounds')} data-i18n-aria="duel.rounds">
          {[3, 5, 10].map(n => (
            <button type="button" data-rounds={n} aria-pressed={n === 5 ? 'true' : 'false'}
                    class="press min-h-11 flex-1 rounded-full bg-line px-2 text-sm font-semibold aria-pressed:bg-cube aria-pressed:text-on-cube">{n}</button>
          ))}
        </div>
      </div>
      <button type="button" data-add-player class={`${secondary} min-h-12 text-base`}></button>
      <button type="button" data-start class={primary} data-i18n="duel.start">{t('duel.start')}</button>
    </div>
    <p data-guest-only class="mt-4 text-muted"></p>
    <p class="mt-4 text-xs text-muted" data-i18n="duel.rules">{t('duel.rules')}</p>
  </div>

  {/* countdown */}
  <div data-screen="countdown" hidden class={`${card} grid min-h-80 place-items-center text-center`}>
    <div>
      <p class="text-muted" data-i18n="duel.get_ready">{t('duel.get_ready')}</p>
      <p data-count class="pop mt-2 text-8xl font-extrabold text-front" aria-live="assertive"></p>
    </div>
  </div>

  {/* play */}
  <div data-screen="play" hidden class="rounded-3xl border-2 border-line bg-surface p-3 sm:p-5">
    <p data-round class="mb-1 text-sm font-semibold"></p>
    {/* race track: every player's character runs from left to right with each solved puzzle (built by duel-app.js) */}
    <div data-track class="relative mb-3 h-9" aria-hidden="true">
      <div class="absolute inset-x-0 top-1/2 h-1.5 -translate-y-1/2 rounded-full bg-line"></div>
    </div>
    <p data-progress-sr class="sr-only"></p>
    <GuessBoard locale={locale}>
      <p data-wait hidden class="mt-2 text-center font-semibold text-muted" aria-live="polite"></p>
    </GuessBoard>
  </div>

  {/* results */}
  <div data-screen="results" hidden class={card}>
    <h1 data-result-title class="pop text-2xl font-extrabold"></h1>
    <div data-scores class="mt-4 grid gap-3 text-center"></div>
    <ul data-highlights class="mt-4 flex flex-col gap-1 text-sm"></ul>
    <div class="mt-4 overflow-x-auto rounded-2xl border-2 border-line">
      <table class="w-full text-left text-sm">
        <thead class="bg-bg/60 text-muted"><tr data-thead></tr></thead>
        <tbody data-rows></tbody>
      </table>
    </div>
    <p data-rematch-status class="mt-4 min-h-6 text-sm font-semibold text-front" aria-live="polite"></p>
    <div class="mt-2 grid grid-cols-2 gap-3">
      <button type="button" data-rematch class={primary} data-i18n="duel.rematch">{t('duel.rematch')}</button>
      <button type="button" data-end class={`${secondary} min-h-12`} data-i18n="duel.end">{t('duel.end')}</button>
    </div>
    {/* how points work (rendered by duel-app.js – contains the other player's name) */}
    <footer data-scoring class="mt-5 border-t-2 border-line pt-3 text-xs text-muted"></footer>
  </div>

  {/* camera scanner (full screen) */}
  <div data-scanner hidden class="fixed inset-0 z-50 flex flex-col items-center justify-center gap-4 bg-bg/95 p-4">
    <p class="text-lg font-bold" data-i18n="duel.scanTitle">{t('duel.scanTitle')}</p>
    <video data-video playsinline muted class="aspect-square w-full max-w-sm rounded-2xl bg-black object-cover"></video>
    <p data-scan-status class="min-h-6 text-center text-sm font-semibold text-front" aria-live="polite"></p>
    <button type="button" data-scan-cancel class={secondary} data-i18n="duel.cancel">{t('duel.cancel')}</button>
  </div>
</section>

<script>
  import { useTranslations } from '../i18n/index.js';
  import { startDuelApp } from '../scripts/duel/duel-app.js';

  // the language can change in place during a duel (live-locale.js) – t always uses the current one
  let lang = document.documentElement.lang;
  const t = (key: string, params?: Record<string, unknown>) => useTranslations(lang)(key, params);
  window.addEventListener('wyrfl-locale', e => (lang = (e as CustomEvent<string>).detail));
  startDuelApp(document.getElementById('duel')!, t);
</script>
