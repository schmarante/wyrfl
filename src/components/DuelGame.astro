---
// Duel: two devices in the same WLAN, paired by QR code (WebRTC without server), same View Guesser puzzles.
// Logic: src/scripts/duel/duel-app.js
import { useTranslations } from '../i18n/index.js';
import { LEVELS } from '../scripts/game/progress.js';
import { AVATARS, avatarUrl } from '../scripts/duel/avatars.js';
import GuessBoard from './GuessBoard.astro';

interface Props {
  locale: 'de' | 'en';
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const primary = 'press inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-cube px-6 text-lg font-bold text-white hover:brightness-110 disabled:opacity-40';
const secondary = 'press inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-line px-5 text-sm font-semibold hover:bg-cube/40 disabled:opacity-40';
const card = 'mx-auto w-full max-w-3xl rounded-3xl border border-line bg-surface p-4 sm:p-6';
const qrBox = 'mx-auto aspect-square w-full max-w-72 overflow-hidden rounded-2xl bg-white p-2';
---

<section id="duel" class="flex flex-col gap-4">
  <p data-banner hidden class="mx-auto w-full max-w-3xl rounded-2xl border border-front/60 bg-front/10 p-3 text-sm font-semibold" role="alert"></p>

  <!-- start -->
  <div data-screen="start" class={card}>
    <h1 class="text-xl font-bold">{t('modes.duel.title')}</h1>
    <p class="mt-2">{t('duel.intro')}</p>
    <p class="mt-2 text-sm text-muted">{t('duel.privacy')}</p>
    <p class="mt-4 text-sm font-semibold" id="duel-avatar-label">{t('duel.pickAvatar')}</p>
    <div data-avatars class="mt-2 grid grid-cols-8 gap-1.5 max-sm:grid-cols-6" role="radiogroup" aria-labelledby="duel-avatar-label">
      {AVATARS.map(id => (
        <button type="button" role="radio" aria-checked="false" data-avatar={id} aria-label={t(`avatars.${id}`)} title={t(`avatars.${id}`)}
                class="press grid aspect-square place-items-center rounded-2xl border-2 border-transparent bg-bg/60 p-1.5 hover:border-line aria-checked:border-cube aria-checked:bg-cube/15">
          <img src={avatarUrl(id)} alt="" width="40" height="40" class="h-full w-full" draggable="false" />
        </button>
      ))}
    </div>
    <p data-unsupported hidden class="mt-4 text-sm font-semibold text-front">{t('duel.unsupported')}</p>
    <div class="mt-5 grid gap-3 sm:grid-cols-2">
      <button type="button" data-host class={primary}>{t('duel.host')}</button>
      <button type="button" data-join class={`${secondary} min-h-12 text-base`}>{t('duel.join')}</button>
    </div>
  </div>

  <!-- host: show offer, scan answer -->
  <div data-screen="host" hidden class={card}>
    <h1 class="text-xl font-bold">{t('duel.host')}</h1>
    <p class="mt-3">{t('duel.step1')}</p>
    <div data-offer-qr class={`${qrBox} mt-3 grid place-items-center text-muted`}>{t('duel.preparing')}</div>
    <p class="mt-5">{t('duel.step2')}</p>
    <button type="button" data-scan-answer disabled class={`${primary} mt-3 w-full`}>{t('duel.scanAnswer')}</button>
    <p data-host-status class="mt-3 min-h-6 text-sm font-semibold" aria-live="polite"></p>
    <details class="mt-4 text-sm">
      <summary class="cursor-pointer text-muted">{t('duel.noCamera')}</summary>
      <div class="mt-3 flex flex-col gap-2">
        <button type="button" data-copy-link disabled class={secondary}>{t('duel.copyLink')}</button>
        <label for="duel-paste" class="mt-2 font-semibold">{t('duel.pasteLabel')}</label>
        <textarea id="duel-paste" data-paste rows="3" class="w-full rounded-xl border border-line bg-bg p-2 font-mono text-xs"></textarea>
        <button type="button" data-paste-connect class={secondary}>{t('duel.connect')}</button>
      </div>
    </details>
  </div>

  <!-- guest: show answer -->
  <div data-screen="guest" hidden class={card}>
    <h1 class="text-xl font-bold">{t('duel.answerTitle')}</h1>
    <p class="mt-3">{t('duel.answerText')}</p>
    <div data-answer-qr class={`${qrBox} mt-3 grid place-items-center text-muted`}>{t('duel.connecting')}</div>
    <p data-guest-status class="mt-3 min-h-6 text-sm font-semibold" aria-live="polite">{t('duel.waiting')}</p>
    <details class="mt-4 text-sm">
      <summary class="cursor-pointer text-muted">{t('duel.noCamera')}</summary>
      <button type="button" data-copy-code disabled class={`${secondary} mt-3`}>{t('duel.copyCode')}</button>
    </details>
  </div>

  <!-- lobby -->
  <div data-screen="lobby" hidden class={card}>
    <div data-versus class="flex items-center justify-center gap-4 py-2"></div>
    <h1 data-connected class="text-center text-xl font-bold"></h1>
    <div data-host-only class="mt-4 flex flex-col gap-4">
      <div>
        <p class="mb-2 text-sm font-semibold">{t('duel.level')}</p>
        <div data-duel-levels class="flex gap-2" role="group" aria-label={t('duel.level')}>
          {LEVELS.map((level, i) => (
            <button type="button" data-level={level} aria-pressed={i === 0 ? 'true' : 'false'}
                    class="press min-h-11 flex-1 rounded-full bg-line px-2 text-sm font-semibold aria-pressed:bg-cube aria-pressed:text-white">
              {t(`levels.${level}`)}
            </button>
          ))}
        </div>
      </div>
      <div>
        <p class="mb-2 text-sm font-semibold">{t('duel.rounds')}</p>
        <div data-duel-rounds class="flex gap-2" role="group" aria-label={t('duel.rounds')}>
          {[3, 5, 10].map(n => (
            <button type="button" data-rounds={n} aria-pressed={n === 5 ? 'true' : 'false'}
                    class="press min-h-11 flex-1 rounded-full bg-line px-2 text-sm font-semibold aria-pressed:bg-cube aria-pressed:text-white">{n}</button>
          ))}
        </div>
      </div>
      <button type="button" data-start class={primary}>{t('duel.start')}</button>
    </div>
    <p data-guest-only class="mt-4 text-muted"></p>
    <p class="mt-4 text-xs text-muted">{t('duel.rules')}</p>
  </div>

  <!-- countdown -->
  <div data-screen="countdown" hidden class={`${card} grid min-h-80 place-items-center text-center`}>
    <div>
      <p class="text-muted">{t('duel.get_ready')}</p>
      <p data-count class="pop mt-2 text-8xl font-extrabold text-front" aria-live="assertive"></p>
    </div>
  </div>

  <!-- play -->
  <div data-screen="play" hidden class="rounded-3xl border border-line bg-surface p-3 sm:p-5">
    <div class="mb-2 flex items-center justify-between gap-2 text-sm">
      <span data-round class="font-semibold"></span>
      <span data-opponent class="inline-flex items-center gap-1.5 rounded-full bg-line py-1 pl-1 pr-3 text-muted"></span>
    </div>
    <div class="mb-3 flex gap-1" aria-hidden="true">
      <div data-my-bar class="h-1.5 flex-1 overflow-hidden rounded-full bg-line"><div class="h-full w-0 bg-cube transition-all"></div></div>
      <div data-their-bar class="h-1.5 flex-1 overflow-hidden rounded-full bg-line"><div class="h-full w-0 bg-front transition-all"></div></div>
    </div>
    <GuessBoard locale={locale}>
      <p data-wait hidden class="mt-2 text-center font-semibold text-muted" aria-live="polite"></p>
    </GuessBoard>
  </div>

  <!-- results -->
  <div data-screen="results" hidden class={card}>
    <h1 data-result-title class="pop text-2xl font-extrabold"></h1>
    <div class="mt-4 grid grid-cols-2 gap-3 text-center">
      <div class="flex flex-col items-center gap-1 rounded-2xl bg-cube/15 p-3"><span data-me-avatar></span><p data-me-name class="text-sm text-muted"></p><p data-me-points class="text-2xl font-bold"></p></div>
      <div class="flex flex-col items-center gap-1 rounded-2xl bg-front/15 p-3"><span data-them-avatar></span><p data-them-name class="text-sm text-muted"></p><p data-them-points class="text-2xl font-bold"></p></div>
    </div>
    <ul data-highlights class="mt-4 flex flex-col gap-1 text-sm"></ul>
    <div class="mt-4 overflow-x-auto rounded-2xl border border-line">
      <table class="w-full text-left text-sm">
        <thead class="bg-bg/60 text-muted"><tr><th class="p-2">{t('duel.roundCol')}</th><th data-th-me class="p-2"></th><th data-th-them class="p-2"></th></tr></thead>
        <tbody data-rows></tbody>
      </table>
    </div>
    <p data-rematch-status class="mt-4 min-h-6 text-sm font-semibold text-front" aria-live="polite"></p>
    <div class="mt-2 grid grid-cols-2 gap-3">
      <button type="button" data-rematch class={primary}>{t('duel.rematch')}</button>
      <button type="button" data-end class={`${secondary} min-h-12`}>{t('duel.end')}</button>
    </div>
  </div>

  <!-- camera scanner (full screen) -->
  <div data-scanner hidden class="fixed inset-0 z-50 flex flex-col items-center justify-center gap-4 bg-bg/95 p-4">
    <p class="text-lg font-bold">{t('duel.scanTitle')}</p>
    <video data-video playsinline muted class="aspect-square w-full max-w-sm rounded-2xl bg-black object-cover"></video>
    <p data-scan-status class="min-h-6 text-center text-sm font-semibold text-front" aria-live="polite"></p>
    <button type="button" data-scan-cancel class={secondary}>{t('duel.cancel')}</button>
  </div>
</section>

<script>
  import { useTranslations } from '../i18n/index.js';
  import { startDuelApp } from '../scripts/duel/duel-app.js';

  startDuelApp(document.getElementById('duel')!, useTranslations(document.documentElement.lang));
</script>
