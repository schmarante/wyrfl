---
// Mode B – Builder: three blueprints (top, front, side), build a matching building on the 3D board.
// Tap / left click = current tool (build by default), right click or long press = remove.
import { useTranslations } from '../i18n/index.js';
import { VIEWS } from '../scripts/game/structure.js';
import Icon from './Icon.astro';

interface Props {
  locale: 'de' | 'en';
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const iconButton = 'press grid h-12 w-12 shrink-0 place-items-center rounded-full bg-line text-text hover:bg-cube/40 disabled:opacity-35 aria-pressed:bg-cube aria-pressed:text-white';
---

<section id="build" class="rounded-3xl border border-line bg-surface p-3 sm:p-5 land:grid land:grid-cols-[minmax(0,1fr)_22rem] land:grid-rows-[auto_1fr] land:gap-x-5">
  <h1 class="sr-only">{t('modes.build.title')}</h1>

  <ul class="grid grid-cols-3 gap-2 sm:gap-3 land:col-start-2 land:row-start-1" aria-label={t('build.plans')}>
    {VIEWS.map(view => (
      <li>
        <button type="button" data-plan={view} aria-pressed="false"
                class="press relative flex h-full w-full flex-col items-center gap-1.5 rounded-2xl border-2 border-line bg-bg/60 p-2 hover:border-cube aria-pressed:bg-cube/20">
          <span data-grid class="grid w-full max-w-24 gap-0.5" aria-hidden="true"></span>
          <span class:list={['text-xs font-semibold sm:text-sm', view === 'front' ? 'text-front' : 'text-muted']}>{t(`views.${view}`)}</span>
          <span data-status class="sr-only"></span>
          <span data-badge hidden aria-hidden="true"></span>
        </button>
      </li>
    ))}
  </ul>

  <div class="relative mt-2 aspect-square w-full overflow-hidden rounded-2xl bg-bg/50 sm:aspect-[4/3] land:col-start-1 land:row-span-2 land:row-start-1 land:mt-0 land:aspect-auto land:h-[max(22rem,calc(100dvh-7rem))]">
    <canvas data-canvas tabindex="0" class="absolute inset-0 h-full w-full cursor-pointer" role="application"
            aria-label={t('build.tapHint')}></canvas>
    <p data-loading class="absolute inset-0 grid place-items-center text-muted">{t('game.loading')}</p>
    <div class="pointer-events-none absolute left-2 top-2" data-level-picker></div>
    <span data-count class="pointer-events-none absolute bottom-2 left-2 rounded-full bg-surface/85 px-3 py-1 text-sm text-muted backdrop-blur"></span>
  </div>

  <div class="land:col-start-2 land:row-start-2">
  <div class="mt-3 flex items-center gap-2">
    <button type="button" data-tool="add" aria-pressed="true" class={iconButton} aria-label={t('build.add')} title={t('build.add')}><Icon name="plus" /></button>
    <button type="button" data-tool="remove" aria-pressed="false" class={iconButton} aria-label={t('build.remove')} title={t('build.removeHint')}><Icon name="minus" /></button>
    <button type="button" data-undo disabled class={iconButton} aria-label={t('build.undo')} title={t('build.undo')}><Icon name="undo" /></button>
    <button type="button" data-clear disabled class={iconButton} aria-label={t('build.clear')} title={t('build.clear')}><Icon name="trash" /></button>
    <button type="button" data-check
            class="press min-h-12 flex-1 rounded-full bg-cube px-4 text-lg font-bold text-white hover:brightness-110">
      {t('build.check')}
    </button>
  </div>

  <p data-feedback class="mt-3 min-h-6 px-1 text-base font-semibold" aria-live="polite"></p>

  <button type="button" data-next hidden
          class="press mt-2 min-h-12 w-full rounded-full bg-front px-6 text-lg font-bold text-bg hover:brightness-110">
    {t('game.next')} →
  </button>
  </div>
</section>

<script>
  import { useTranslations } from '../i18n/index.js';
  import { generateStructure, emptyStructure, computeView, viewsEqual, diffView, cubeCount, VIEWS } from '../scripts/game/structure.js';
  import { recordSolved } from '../scripts/game/progress.js';
  import { renderViewGrid } from '../scripts/ui/view-grid.js';
  import { createLevelPicker, practiceSeed } from '../scripts/ui/level-picker.js';

  type Structure = ReturnType<typeof generateStructure>;
  type Column = { x: number; z: number };
  type Tool = 'add' | 'remove';

  const MODE = 'build';
  const t = useTranslations(document.documentElement.lang);
  const root = document.getElementById('build')!;
  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

  const canvas = $<HTMLCanvasElement>('[data-canvas]');
  const feedback = $('[data-feedback]');
  const undoButton = $<HTMLButtonElement>('[data-undo]');
  const clearButton = $<HTMLButtonElement>('[data-clear]');
  const nextButton = $<HTMLButtonElement>('[data-next]');
  const toolButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-tool]')];
  const planButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-plan]')];

  let scene: Awaited<ReturnType<typeof loadScene>> | null = null;
  let target: Structure;
  let built: Structure;
  let history: number[][][] = [];
  let tool: Tool = 'add';
  let solved = false;
  let cursor: Column = { x: 0, z: 0 };

  async function loadScene() {
    const { createCubeScene } = await import('../scripts/game/scene.js');
    return createCubeScene(canvas, { editable: true, onTap: (column: Column, action: Tool) => change(column, action) });
  }

  const picker = createLevelPicker($('[data-level-picker]'), MODE, t, () => newPuzzle());

  function say(text: string, tone: 'good' | 'info' = 'info') {
    feedback.textContent = text;
    feedback.classList.toggle('text-front', tone === 'good');
    feedback.classList.remove('pop');
    if (tone === 'good') {
      void feedback.offsetWidth;
      feedback.classList.add('pop');
    }
  }

  /** Blueprints; with `checked` each one shows whether it matches and marks the differing cells. */
  function renderPlans(checked = false) {
    for (const button of planButtons) {
      const view = button.dataset.plan!;
      const want = computeView(target, view);
      const have = computeView(built, view);
      const ok = viewsEqual(want, have);
      renderViewGrid(button.querySelector('[data-grid]')!, want, {
        fill: view === 'front' ? 'front' : 'cube',
        marks: checked && !ok ? diffView(want, have) : null,
      });
      // after a check: matching plans get a yellow outline + ✓ badge, the others a ✗ badge (like the View Guesser)
      button.querySelector<HTMLElement>('[data-status]')!.textContent = checked ? t(ok ? 'build.ok' : 'build.notOk') : '';
      button.classList.toggle('border-front', checked && ok);
      button.classList.toggle('border-line', !(checked && ok));
      const badge = button.querySelector<HTMLElement>('[data-badge]')!;
      badge.hidden = !checked;
      badge.textContent = ok ? '✓' : '✗';
      badge.className = `absolute -right-2.5 -top-2.5 grid h-6 w-6 place-items-center rounded-full text-xs font-bold shadow-sm ring-2 ring-surface ${ok ? 'bg-front text-bg' : 'bg-line text-text'}`;
    }
  }

  function update(heightsOnly = false) {
    $('[data-count]').textContent = t('build.cubes', { count: cubeCount(built) });
    undoButton.disabled = history.length === 0;
    clearButton.disabled = cubeCount(built) === 0;
    if (!heightsOnly) scene?.setHeights(built.heights);
  }

  function newPuzzle() {
    target = generateStructure(practiceSeed(), picker.level);
    built = emptyStructure(target.size, target.maxHeight);
    history = [];
    solved = false;
    cursor = { x: 0, z: target.size - 1 };
    nextButton.hidden = true;
    planButtons.forEach(b => b.setAttribute('aria-pressed', 'false'));
    say('');
    renderPlans();
    scene?.setStructure(built);
    update(true);
  }

  /** Applies a tool to a column (tap / left click = current tool, right click / long press = remove, keyboard). */
  function change({ x, z }: Column, action: Tool = tool) {
    const h = built.heights[z][x];
    if (action === 'add' && h >= built.maxHeight) {
      say(t('build.full', { max: built.maxHeight }));
      return;
    }
    if (action === 'remove' && h === 0) return;
    history.push(built.heights.map(row => [...row]));
    built.heights[z][x] = h + (action === 'add' ? 1 : -1);
    if (!solved) say('');
    renderPlans();   // an edit clears the check marks
    update();
  }

  function setTool(next: Tool) {
    tool = next;
    toolButtons.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.tool === next)));
    scene?.setTool(next);
  }
  toolButtons.forEach(b => b.addEventListener('click', () => setTool(b.dataset.tool as Tool)));

  undoButton.addEventListener('click', () => {
    const previous = history.pop();
    if (!previous) return;
    built.heights = previous;
    renderPlans();
    update();
  });
  clearButton.addEventListener('click', () => {
    history.push(built.heights.map(row => [...row]));
    built = emptyStructure(target.size, target.maxHeight);
    renderPlans();
    update();
  });

  // tap a blueprint → look at the building from that side; tap again → back to the tilted view
  for (const button of planButtons) {
    button.addEventListener('click', () => {
      const active = button.getAttribute('aria-pressed') === 'true';
      planButtons.forEach(b => b.setAttribute('aria-pressed', String(!active && b === button)));
      scene?.lookFrom(active ? 'iso' : button.dataset.plan!);
    });
  }

  $('[data-check]').addEventListener('click', () => {
    if (cubeCount(built) === 0) {
      say(t('build.empty'));
      return;
    }
    renderPlans(true);
    const ok = VIEWS.every(v => viewsEqual(computeView(built, v), computeView(target, v)));
    if (!ok) {
      say(t('build.almost'));
      return;
    }
    if (!solved) {
      solved = true;
      const unlocked = recordSolved(MODE, picker.level);
      picker.refresh();
      say(`${t('build.success')} ${t('build.successNote')}` + (unlocked ? ` ★ ${t('level.unlocked', { level: t(`levels.${unlocked}`) })}` : ''), 'good');
    }
    nextButton.hidden = false;
    nextButton.focus({ preventScroll: true });
  });
  nextButton.addEventListener('click', () => newPuzzle());

  // keyboard: arrows move the preview cube, Enter/Space = current tool, Delete/Backspace = remove, +/- switch the tool
  canvas.addEventListener('keydown', e => {
    const moves: Record<string, [number, number]> = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
    if (e.key in moves) {
      const [dx, dz] = moves[e.key];
      cursor = { x: Math.min(target.size - 1, Math.max(0, cursor.x + dx)), z: Math.min(target.size - 1, Math.max(0, cursor.z + dz)) };
    } else if (e.key === 'Enter' || e.key === ' ') {
      change(cursor);
    } else if (e.key === 'Delete' || e.key === 'Backspace') {
      change(cursor, 'remove');
    } else if (e.key === '+' || e.key === '-') {
      setTool(e.key === '+' ? 'add' : 'remove');
    } else return;
    e.preventDefault();
    scene?.highlight(cursor);
  });
  canvas.addEventListener('focus', () => scene?.highlight(cursor));
  canvas.addEventListener('blur', () => scene?.highlight(null));

  newPuzzle();
  loadScene()
    .then(s => {
      scene = s;
      $('[data-loading]').hidden = true;
      scene.setStructure(built);
      scene.setTool(tool);
    })
    .catch(() => ($('[data-loading]').textContent = t('home.noWebgl')));
</script>
