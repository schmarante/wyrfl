---
// Mode B – Builder: three blueprints (top, front, side), build a matching building on the 3D board.
import { useTranslations } from '../i18n/index.js';
import { VIEWS } from '../scripts/game/structure.js';
import LevelPicker from './LevelPicker.astro';
import Icon from './Icon.astro';

interface Props {
  locale: 'de' | 'en';
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const toolClass = 'press inline-flex items-center justify-center gap-1.5 min-h-11 flex-1 rounded-full px-4 text-sm font-semibold aria-pressed:bg-cube aria-pressed:text-white bg-line hover:bg-cube/40';
---

<section id="build" class="flex flex-col gap-4">
  <LevelPicker locale={locale} />

  <div class="rounded-3xl border border-line bg-surface p-4 sm:p-6">
    <h1 class="text-xl font-bold">{t('modes.build.title')}</h1>
    <p class="mt-1 text-sm text-muted">{t('build.intro')}</p>

    <h2 class="sr-only">{t('build.plans')}</h2>
    <ul class="mt-4 grid grid-cols-3 gap-2 sm:gap-3">
      {VIEWS.map(view => (
        <li>
          <button type="button" data-plan={view} aria-pressed="false"
                  class="press flex h-full w-full flex-col items-center gap-2 rounded-2xl border-2 border-line bg-bg/60 p-2 sm:p-3 hover:border-cube aria-pressed:border-cube">
            <span data-grid class="grid w-full max-w-28 gap-0.5" aria-hidden="true"></span>
            <span class:list={['text-sm font-semibold', view === 'front' ? 'text-front' : 'text-muted']}>{t(`views.${view}`)}</span>
            <span data-status class="min-h-5 text-xs"></span>
          </button>
        </li>
      ))}
    </ul>

    <div class="relative mt-4 aspect-square w-full sm:aspect-[4/3]">
      <canvas data-canvas tabindex="0" class="absolute inset-0 h-full w-full cursor-pointer rounded-2xl" role="application"
              aria-label={t('build.tapHint')}></canvas>
      <p data-loading class="absolute inset-0 grid place-items-center text-muted">{t('game.loading')}</p>
      <span data-count class="pointer-events-none absolute left-2 top-2 rounded-full bg-bg/80 px-3 py-1 text-sm text-muted"></span>
    </div>
    <p class="mt-2 text-sm text-muted">{t('build.tapHint')}</p>

    <div class="mt-3 flex flex-wrap gap-2">
      <div class="flex flex-1 gap-2" role="group">
        <button type="button" data-tool="add" aria-pressed="true" class={toolClass}><Icon name="plus" /> {t('build.add')}</button>
        <button type="button" data-tool="remove" aria-pressed="false" class={toolClass}><Icon name="minus" /> {t('build.remove')}</button>
      </div>
      <div class="flex flex-1 gap-2">
        <button type="button" data-undo disabled
                class="press inline-flex min-h-11 flex-1 items-center justify-center gap-1.5 rounded-full bg-line px-4 text-sm font-semibold hover:bg-cube/40 disabled:opacity-40"><Icon name="undo" /> {t('build.undo')}</button>
        <button type="button" data-clear disabled
                class="press min-h-11 flex-1 rounded-full bg-line px-4 text-sm font-semibold hover:bg-cube/40 disabled:opacity-40">{t('build.clear')}</button>
      </div>
    </div>

    <button type="button" data-check
            class="press mt-4 min-h-12 w-full rounded-full bg-cube px-6 text-lg font-bold text-white hover:brightness-110">
      {t('build.check')}
    </button>

    <p data-feedback class="mt-4 min-h-12 px-1 text-base font-semibold" aria-live="polite"></p>

    <button type="button" data-next hidden
            class="press mt-2 min-h-12 w-full rounded-full bg-front px-6 text-lg font-bold text-bg hover:brightness-110">
      {t('game.next')} →
    </button>
  </div>
</section>

<script>
  import { useTranslations } from '../i18n/index.js';
  import { generateStructure, emptyStructure, computeView, viewsEqual, diffView, cubeCount, VIEWS } from '../scripts/game/structure.js';
  import { recordSolved } from '../scripts/game/progress.js';
  import { renderViewGrid } from '../scripts/ui/view-grid.js';
  import { createLevelPicker, practiceSeed } from '../scripts/ui/level-picker.js';

  type Structure = ReturnType<typeof generateStructure>;
  type Column = { x: number; z: number };

  const MODE = 'build';
  const t = useTranslations(document.documentElement.lang);
  const root = document.getElementById('build')!;
  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

  const canvas = $<HTMLCanvasElement>('[data-canvas]');
  const feedback = $('[data-feedback]');
  const undoButton = $<HTMLButtonElement>('[data-undo]');
  const clearButton = $<HTMLButtonElement>('[data-clear]');
  const nextButton = $<HTMLButtonElement>('[data-next]');
  const toolButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-tool]')];
  const planButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-plan]')];

  let scene: Awaited<ReturnType<typeof loadScene>> | null = null;
  let target: Structure;
  let built: Structure;
  let history: number[][][] = [];
  let tool: 'add' | 'remove' = 'add';
  let solved = false;
  let cursor: Column = { x: 0, z: 0 };

  async function loadScene() {
    const { createCubeScene } = await import('../scripts/game/scene.js');
    return createCubeScene(canvas, { editable: true, onTap: change });
  }

  const picker = createLevelPicker($('[data-level-picker]'), MODE, t, () => newPuzzle());

  function say(text: string, tone: 'good' | 'info' = 'info') {
    feedback.textContent = text;
    feedback.classList.toggle('text-front', tone === 'good');
    feedback.classList.remove('pop');
    if (tone === 'good') {
      void feedback.offsetWidth;
      feedback.classList.add('pop');
    }
  }

  /** Blueprints; with `checked` each one shows whether it matches and marks the differing cells. */
  function renderPlans(checked = false) {
    for (const button of planButtons) {
      const view = button.dataset.plan!;
      const want = computeView(target, view);
      const have = computeView(built, view);
      const ok = viewsEqual(want, have);
      renderViewGrid(button.querySelector('[data-grid]')!, want, {
        fill: view === 'front' ? 'front' : 'cube',
        marks: checked && !ok ? diffView(want, have) : null,
      });
      const status = button.querySelector<HTMLElement>('[data-status]')!;
      status.textContent = checked ? (ok ? `✓ ${t('build.ok')}` : `✗ ${t('build.notOk')}`) : '';
      status.className = `min-h-5 text-xs ${ok ? 'text-front' : 'text-text'}`;
    }
  }

  function update() {
    $('[data-count]').textContent = t('build.cubes', { count: cubeCount(built) });
    undoButton.disabled = history.length === 0;
    clearButton.disabled = cubeCount(built) === 0;
    scene?.setHeights(built.heights);
  }

  function newPuzzle() {
    target = generateStructure(practiceSeed(), picker.level);
    built = emptyStructure(target.size, target.maxHeight);
    history = [];
    solved = false;
    cursor = { x: 0, z: target.size - 1 };
    nextButton.hidden = true;
    planButtons.forEach(b => b.setAttribute('aria-pressed', 'false'));
    say('');
    renderPlans();
    scene?.setStructure(built);
    update();
  }

  /** Applies the current tool to a column (tap, click or keyboard). */
  function change({ x, z }: Column) {
    const h = built.heights[z][x];
    if (tool === 'add' && h >= built.maxHeight) {
      say(t('build.full', { max: built.maxHeight }));
      return;
    }
    if (tool === 'remove' && h === 0) return;
    history.push(built.heights.map(row => [...row]));
    built.heights[z][x] = h + (tool === 'add' ? 1 : -1);
    if (!solved) say('');
    renderPlans();   // an edit clears the check marks
    update();
  }

  function setTool(next: 'add' | 'remove') {
    tool = next;
    toolButtons.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.tool === next)));
    scene?.setTool(next);
  }
  toolButtons.forEach(b => b.addEventListener('click', () => setTool(b.dataset.tool as 'add' | 'remove')));

  undoButton.addEventListener('click', () => {
    const previous = history.pop();
    if (!previous) return;
    built.heights = previous;
    renderPlans();
    update();
  });
  clearButton.addEventListener('click', () => {
    history.push(built.heights.map(row => [...row]));
    built = emptyStructure(target.size, target.maxHeight);
    renderPlans();
    update();
  });

  // tap a blueprint → look at the building from that side; tap again → back to the tilted view
  for (const button of planButtons) {
    button.addEventListener('click', () => {
      const active = button.getAttribute('aria-pressed') === 'true';
      planButtons.forEach(b => b.setAttribute('aria-pressed', String(!active && b === button)));
      scene?.lookFrom(active ? 'iso' : button.dataset.plan!);
    });
  }

  $('[data-check]').addEventListener('click', () => {
    if (cubeCount(built) === 0) {
      say(t('build.empty'));
      return;
    }
    renderPlans(true);
    const ok = VIEWS.every(v => viewsEqual(computeView(built, v), computeView(target, v)));
    if (!ok) {
      say(t('build.almost'));
      return;
    }
    if (!solved) {
      solved = true;
      const unlocked = recordSolved(MODE, picker.level);
      picker.refresh();
      say(`${t('build.success')} ${t('build.successNote')}` + (unlocked ? ' ★ ' + t('level.unlocked', { level: t(`levels.${unlocked}`) }) : ''), 'good');
    }
    nextButton.hidden = false;
    nextButton.focus({ preventScroll: true });
  });
  nextButton.addEventListener('click', () => newPuzzle());

  // keyboard: arrows move the preview cube, Enter/Space builds (or removes), +/- switch the tool
  canvas.addEventListener('keydown', e => {
    const moves: Record<string, [number, number]> = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
    if (e.key in moves) {
      const [dx, dz] = moves[e.key];
      cursor = { x: Math.min(target.size - 1, Math.max(0, cursor.x + dx)), z: Math.min(target.size - 1, Math.max(0, cursor.z + dz)) };
    } else if (e.key === 'Enter' || e.key === ' ') {
      change(cursor);
    } else if (e.key === '+' || e.key === '-') {
      setTool(e.key === '+' ? 'add' : 'remove');
    } else return;
    e.preventDefault();
    scene?.highlight(cursor);
  });
  canvas.addEventListener('focus', () => scene?.highlight(cursor));
  canvas.addEventListener('blur', () => scene?.highlight(null));

  newPuzzle();
  loadScene()
    .then(s => {
      scene = s;
      $('[data-loading]').hidden = true;
      scene.setStructure(built);
      scene.setTool(tool);
    })
    .catch(() => ($('[data-loading]').textContent = t('home.noWebgl')));
</script>
