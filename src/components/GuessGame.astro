---
// Mode A – View Guesser (practice): endless puzzles, difficulty stars in the 3D view, progress.
import { useTranslations } from '../i18n/index.js';
import GuessBoard from './GuessBoard.astro';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="guess" class="rounded-3xl border-2 border-line bg-surface p-3 sm:p-5">
  <GuessBoard locale={locale}>
    <button type="button" data-next hidden
            class="press mt-2 min-h-12 w-full rounded-full bg-cube px-6 text-lg font-bold text-white hover:brightness-110">
      {t('game.next')} →
    </button>
  </GuessBoard>
</section>

<script>
  import { useTranslations } from '../i18n/index.js';
  import { createGuessPuzzle } from '../scripts/game/guess.js';
  import { recordSolved } from '../scripts/game/progress.js';
  import { createGuessBoard } from '../scripts/ui/guess-board.js';
  import { createLevelPicker, practiceSeed } from '../scripts/ui/level-picker.js';
  import { levelUp } from '../scripts/ui/level-up.js';

  const MODE = 'guess';
  const t = useTranslations(document.documentElement.lang);
  const root = document.getElementById('guess')!;
  const nextButton = root.querySelector<HTMLButtonElement>('[data-next]')!;

  const board = createGuessBoard(root.querySelector('[data-guess-board]')!, t, {
    onSolved() {
      const result = recordSolved(MODE, picker.level);
      picker.refresh();
      const showNext = () => {
        nextButton.hidden = false;
        nextButton.focus({ preventScroll: true });
      };
      // level completed: celebrate, then straight on to the next level (no "next" button in between)
      if (result.completed) levelUp(t, result, picker).then(moved => moved || showNext());
      else showNext();
    },
  });
  const picker = createLevelPicker(root.querySelector('[data-level-picker]')!, MODE, t, () => newPuzzle());

  function newPuzzle() {
    nextButton.hidden = true;
    board.show(createGuessPuzzle(practiceSeed(), picker.level));
  }

  nextButton.addEventListener('click', newPuzzle);
  newPuzzle();
</script>
